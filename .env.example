# =============================================================================
# Baihua Server - Environment Variables
# =============================================================================
# This is the canonical example for local development.
#
# Development:
#   cp .env.example .env
#   docker compose up -d database
#
# Production deployments should copy .env.production.example instead.
#
# NEVER commit .env or .env.production files containing real credentials!
# =============================================================================

# ---- Environment Selection ----
# Set to "production" to run in production mode.
# Leave unset or set to anything else for development mode.
#   - Development: console enabled, human-readable logs
#   - Production:  console disabled, JSON logs, requires all vars set
# BAIHUA_ENV=production

# ---- Database ----
# PostgreSQL connection details.
# The values below are safe for development.
POSTGRES_USER=baihua_user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=2423
POSTGRES_DB=baihua-database

# ---- JWT Secret ----
# In development, defaults to "your-default-jwt-secret-key" if unset.
# JWT_SECRET=your-development-secret-here

# ---- Application Directory ----
# Override the default app directory (~/.baihua).
# Useful for testing or custom deployments.
# BAIHUA_DIR=~/.baihua
