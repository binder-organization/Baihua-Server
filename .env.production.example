# =============================================================================
# Baihua Server - Production Environment Variables
# =============================================================================
# Copy this file to .env.production before deploying:
#
#   cp .env.production.example .env.production
#
# Then replace every placeholder value below. Never commit .env.production.
# =============================================================================

# ---- Database ----
# Use a dedicated database user and a long random password.
POSTGRES_USER=baihua
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=baihua

# ---- Token Signing ----
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-token-signing-secret

# Require encrypted client connections in the production environment.
# Set to false only when intentionally allowing unencrypted client connections.
BAIHUA_REQUIRE_ENCRYPTED_TRANSPORT=true

# ---- Public Reverse Proxy ----
# The domain address must point to this deployment host before first startup.
# Caddy starts automatically with the production profile.
BAIHUA_DOMAIN=chat.example.com

# ---- Email Verification ----
# This file is the source of mail settings for the Compose deployment.
# Nonempty values here override matching settings in config.toml.
# Address shown as the sender of verification messages. Replace the example.
BAIHUA_MAIL_SENDER_ADDRESS=verification@example.com
# Mail server address supplied by your mail provider. Replace the example.
BAIHUA_MAIL_SERVER_ADDRESS=mail.example.com
# Mail server port: commonly 587 for starttls or 465 for implicit encryption.
BAIHUA_MAIL_SERVER_PORT=587
# Encrypted connection mode: starttls or implicit. Match the selected port.
BAIHUA_MAIL_SECURITY=starttls
# Mail account name used for authentication. Leave empty if none is required.
BAIHUA_MAIL_USERNAME=verification@example.com
# Application-specific mail password when a username is set. Never place it
# in config.toml; the server reads the password only from the environment.
BAIHUA_MAIL_PASSWORD=replace-with-mail-application-password
# Maximum messages sent to one address in a rolling minute, including
# registration messages. Must be greater than zero; the default is 2.
BAIHUA_MAIL_SENDS_PER_EMAIL_PER_MINUTE=2
# Verification link lifetime in minutes. Allowed range: 1 through 30;
# the default is 15.
BAIHUA_EMAIL_TOKEN_LIFETIME_MINUTES=15
# Optional message template. Mount the text file into the server container
# and use its path inside the container. The file must contain
# {{verification_url}}; {{username}} and {{expires_minutes}} are optional.
# BAIHUA_MAIL_TEMPLATE_PATH=/app/mail-template.txt
# Optional path inside the container to a trusted certificate for a private
# mail server. Leave unset for a public mail server with a trusted certificate.
# BAIHUA_MAIL_TRUSTED_ROOT_CERTIFICATE_PATH=/app/mail-root-certificate.pem
# Optional message subject. The default is shown below; it cannot be blank.
# BAIHUA_MAIL_SUBJECT=Verify your Baihua email address
# Optional display name shown beside the sender address. Default: Baihua.
# BAIHUA_MAIL_SENDER_NAME=Baihua
# Optional public base address for verification links. By default, the server
# uses https://BAIHUA_DOMAIN:2424. Production requires an encrypted address.
# BAIHUA_VERIFICATION_BASE_URL=https://chat.example.com:2424
