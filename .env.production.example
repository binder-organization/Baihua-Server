# =============================================================================
# Baihua Server - Production Environment Variables
# =============================================================================
# Copy this file to .env.production before deploying:
#
#   cp .env.production.example .env.production
#
# Then replace every placeholder value below. Never commit .env.production.
# =============================================================================

# ---- Database ----
# Use a dedicated database user and a long random password.
POSTGRES_USER=baihua
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=baihua

# ---- Token Signing ----
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-token-signing-secret

# ---- Public Reverse Proxy ----
# Required only when starting the public profile.
# The domain address must point to this deployment host before first startup.
BAIHUA_DOMAIN=chat.example.com
